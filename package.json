{
  "name": "blocknote-diff-lab-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local before/after comparison harness for pinned BlockNote Git revisions",
  "scripts": {
    "doctor": "node bin/diff-lab.mjs doctor",
    "lab:prepare": "node bin/diff-lab.mjs prepare",
    "install:before": "node bin/diff-lab.mjs install --side before",
    "install:after": "node bin/diff-lab.mjs install --side after",
    "start": "node bin/diff-lab.mjs start",
    "demo": "node bin/diff-lab.mjs demo",
    "capture": "node bin/diff-lab.mjs capture",
    "test": "node --test tests/*.test.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:bundles": "bash scripts/build-static-bundles.sh",
    "test:pages": "node tests/pages.e2e.mjs",
    "check:previews": "node scripts/check-previews.mjs",
    "test:a11y": "playwright test --config playwright.a11y.config.mjs",
    "test:a11y:local": "SKIP_NETWORK=1 playwright test --config playwright.a11y.config.mjs",
    "test:a11y:previews": "playwright test --config playwright.a11y.config.mjs --grep @previews",
    "test:a11y:axe": "playwright test --config playwright.a11y.config.mjs --grep @axe",
    "test:a11y:guidepup": "playwright test --config playwright.a11y.config.mjs --grep @guidepup",
    "test:a11y:keyboard": "playwright test --config playwright.a11y.config.mjs --grep @keyboard",
    "test:a11y:semantics": "playwright test --config playwright.a11y.config.mjs --grep @semantics",
    "mcp:playwright": "node node_modules/@playwright/mcp/cli.js --headless --isolated"
  },
  "devDependencies": {
    "@guidepup/virtual-screen-reader": "0.33.0",
    "@playwright/mcp": "0.0.86",
    "@playwright/test": "1.60.0",
    "axe-core": "4.13.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
